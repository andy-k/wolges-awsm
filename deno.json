{
  "exclude": ["pkg-web", "data"],
  "fmt": {
    "include": ["src/"]
  },
  "lint": {
    "include": ["src/"]
  },
  "tasks": {
    "serve": "deno run --allow-read=data,pkg-web --allow-net=0.0.0.0:4500 src/wolges.ts",
    "smoke": "deno run --allow-read=data,pkg-web,. src/wolges.ts analyze sample-analyze.json",
    "check": "deno check src/wolges.ts",
    "lint": "deno lint",
    "fmt": "deno fmt"
  }
}
